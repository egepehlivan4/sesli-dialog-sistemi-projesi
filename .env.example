# Bu dosyayı .env olarak kopyala ve kendi makinene göre değerleri değiştir.
# .env dosyası git'e eklenmez (bkz. .gitignore).
#
# Hiçbir değişken ayarlanmazsa config.py Mac/CPU için varsayılanları kullanır.

# --- Genel ---
LOG_LEVEL=INFO
# Model dosyalarının (piper ses modeli vb.) bulunduğu klasör.
MODELS_DIR=./models

# --- Ses I/O (sounddevice) ---
SAMPLE_RATE=16000
CHANNELS=1
AUDIO_DTYPE=float32
# Belirli bir giriş/çıkış cihazı seçmek için sounddevice cihaz adı/indeksi.
# Boş bırakılırsa sistem varsayılanı kullanılır.
INPUT_DEVICE=
OUTPUT_DEVICE=
# Mikrofon okuma / hoparlör çalma chunk boyutu (milisaniye).
AUDIO_CHUNK_MS=20

# --- VAD (silero-vad) ---
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_MS=250
VAD_MIN_SILENCE_MS=500

# --- ASR (faster-whisper) ---
ASR_MODEL_SIZE=small
# Mac: cpu | Windows (NVIDIA GPU varsa): cuda
ASR_DEVICE=cpu
# Mac/CPU: int8 | GPU: float16
ASR_COMPUTE_TYPE=int8
ASR_LANGUAGE=tr

# --- LLM (Ollama HTTP API) ---
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:3b
LLM_TIMEOUT_S=30
# tests/compare_llm.py bu modelleri karşılaştırır (virgülle ayrılmış).
LLM_COMPARE_MODELS=qwen2.5:3b,qwen2.5:7b,gemma3:4b

# --- TTS (piper-tts) ---
TTS_VOICE=tr_TR-dfki-medium
# Boş bırakılırsa MODELS_DIR/<TTS_VOICE>.onnx (ve .onnx.json) kullanılır.
TTS_MODEL_PATH=
TTS_CONFIG_PATH=
